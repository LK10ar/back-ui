PORT=5000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/uipact?retryWrites=true&w=majority
ADMIN_PASSWORD=choisis-un-mot-de-passe-solide
JWT_SECRET=une-longue-chaine-aleatoire
# Origines autorisées (sans slash final, sans chemin). Ton site + l'admin sont sur la même origine GitHub Pages.
CORS_ORIGINS=https://lk10ar.github.io,http://localhost:5500

# Upload de photos vers Cloudflare R2 (optionnel : sans ça, l'admin accepte les URL et les chemins img/xxx.png)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# Notification par email des messages du formulaire de contact (optionnel, compte gratuit sur resend.com).
# Sans ça, les messages arrivent quand même dans l'onglet « Messages » de l'admin.
RESEND_API_KEY=
CONTACT_TO=uipact@gmail.com
RESEND_FROM=

# Traduction : DeepL gratuit (le plus fiable), sinon Google puis MyMemory sont utilisés automatiquement
# DEEPL_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:fx
